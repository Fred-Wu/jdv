    "generation": 1,
    "title": "object",
    "path": [],
    "kind": "tree",
    "access": "random",
    "encoding": "r-json",
    "class": ["list"],
    "capabilities": \{
      "seek": true,
      "sort": false,
      "filter": false,
      "known_total": true,
      "next": false,
      "children": true
    \}
  \}
